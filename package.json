{
  "name": "shared-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "vite build",
    "dev": "concurrently -k -n client,server -c blue,yellow \"vite\" \"wrangler dev\"",
    "build": "tsc --noEmit && tsc -p server && vite build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/three": "^0.180.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
